# Copy to .env and fill in. Settings use the MERIDIAN_ prefix with "__" for nesting.
MERIDIAN_VOYAGE__API_KEY=
MERIDIAN_GENERATION__API_KEY=

# Optional: pace Voyage requests for accounts without a payment method (3 RPM / 10K TPM).
# Use 6000 tokens, not 10K: ~9K-token batches were rejected under the 10K limit.
# MERIDIAN_VOYAGE__REQUESTS_PER_MINUTE=3
# MERIDIAN_VOYAGE__TOKENS_PER_MINUTE=6000

# Optional: Qdrant (defaults to the docker-compose instance).
# MERIDIAN_QDRANT__URL=http://localhost:6333
# MERIDIAN_QDRANT__API_KEY=
